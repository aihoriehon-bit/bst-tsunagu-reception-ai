      "durationSeconds": 18.32,
      "pitchSemitones": 1,
      "pitchChoice": "B"
    },
    {
      "key": "guideEmployee",
      "text": "お取り次ぎは必要ですか？1番、受付を利用する。2番、必要ありません。",
      "sha256": "6d1a4df4c9e45f64bf35d8cf96a8c351a5f665f32d513fc383d25770c04bc0c1",
      "bytes": 328364,
      "sourceSHA256": "bdca9a483760af121cd93f761c0f1a94164af8223c21013aa4567d64b1998c2e",
